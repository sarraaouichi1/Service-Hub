{
  "name": "service-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @service-hub/shared build && pnpm --parallel --filter \"@service-hub/shared\" --filter \"./apps/*\" dev",
    "build": "pnpm --filter @service-hub/shared build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:migrate": "pnpm --filter @service-hub/api db:migrate",
    "db:seed": "pnpm --filter @service-hub/api db:seed"
  },
  "packageManager": "pnpm@10.33.0"
}
