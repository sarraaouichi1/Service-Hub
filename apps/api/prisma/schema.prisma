// The app owns its users, whoever vouches for them.
//
// A local account carries a password hash and issuer "local". An account from
// an identity provider carries issuer + externalId and no password. Either way
// there is a row here, and roles hang off that row rather than off the token —
// so switching to OIDC never means trusting someone else with authorisation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  initials     String
  partner      String    @default("")
  color        String    @default("#1A6FD4")
  status       String    @default("active")
  roles        String[]  @default([])

  /// Null for accounts that can only sign in through an identity provider.
  passwordHash String?
  /// "local", or the OIDC issuer URL that vouches for this user.
  issuer       String    @default("local")
  /// The provider's stable subject claim. Never the email — addresses get reassigned.
  externalId   String?

  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  draft        OnboardingDraft?

  @@unique([issuer, externalId])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  /// The cookie carries the token; only its hash is stored, so a leaked
  /// database does not hand over live sessions.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Onboarding domain ───────────────────────────────────────────────────────
// Integer ids because the screens already address these rows by number; users
// get uuids because those ids travel in sessions and links.

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  partner   String
  pm        String
  step      Int      @default(0)
  total     Int      @default(6)
  status    String   @default("draft")
  psp       String   @default("")
  country   String   @default("")
  product   String   @default("smart-web-pay")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Template {
  id        Int      @id @default(autoincrement())
  title     String
  country   String
  lang      String
  currency  String
  vat       String
  psp       String
  status    String   @default("draft")
  projects  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The rule catalogue as server state. What the wizard *enforces* still comes
/// from packages/shared; these rows carry the parts an admin can change.
model Rule {
  id          Int      @id
  field       String
  category    String
  type        String
  pattern     String
  severity    String
  active      Boolean  @default(true)
  description String
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  desc      String
  time      String
  read      Boolean  @default(false)
  color     String
  iconColor String
  createdAt DateTime @default(now())
}

/// One row, id "platform". A settings table with a single row beats a
/// key-value store here: the shape is fixed and typed.
model PlatformSetting {
  id                  String   @id @default("platform")
  platformName        String
  supportEmail        String
  defaultPM           String
  notifyOnSubmit      Boolean  @default(true)
  notifyOnApprove     Boolean  @default(true)
  notifyOnReject      Boolean  @default(true)
  requireDualApproval Boolean  @default(false)
  autoExportOnApprove Boolean  @default(false)
  sessionTimeout      String   @default("30")
  exportFormat        String   @default("json")
  updatedAt           DateTime @updatedAt
}

/// One working draft per person, so "Save Draft" survives a reload.
model OnboardingDraft {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
